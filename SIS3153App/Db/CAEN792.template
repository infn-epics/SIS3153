# Database for CAEN V792 QDC (32 channels)
# Base address is passed as $(BASE) macro
# Port name is $(PORT)
# Prefix is $(P)

#########################################
# Board Identification Registers
#########################################

record(longin,"$(P)ManufacturerID") {
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),0) A32D16 $(BASE)0x802A")
    field(SCAN, "I/O Intr")
    field(PINI, "YES")
    info(autosaveFields_pass0, "SCAN")
}

record(longin,"$(P)BoardID") {
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),0) A32D16 $(BASE)0x803A")
    field(SCAN, "I/O Intr")
    field(PINI, "YES")
}

