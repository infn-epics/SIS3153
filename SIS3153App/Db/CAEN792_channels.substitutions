# Substitution file for CAEN V792 - 32 channel QDC
# Usage: dbLoadTemplate("CAEN792_channels.substitutions", "P=XXX:,PORT=VME1,BASE=0xEE540000")

file "CAEN792.template" {
    pattern { P,           PORT,    BASE }
            { "$(P)",      "$(PORT)", "$(BASE)" }
}

