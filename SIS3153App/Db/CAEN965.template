#########################################
# Data Readout (32-bit FIFO at address 0)
#########################################

record(longin,"$(P)DataFIFO") {
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),0) A32D32 $(BASE)0000")
    field(SCAN, "Passive")
}

record(waveform, "$(P)A32BLT32_DUMMY") {
  field(DESC, "Forza creazione asynInt32Array")
  field(DTYP, "asynInt32ArrayIn")
  field(INP,  "@asyn($(PORT),0) A32BLT32 $(BASE)0000")
  field(FTVL, "LONG")     # perché sono epicsInt32
  field(NELM, "32")     # numero di word max che vuoi supportare
  field(SCAN, "I/O Intr")
}

#########################################
# Acquisition diagnostics (wrapper-local)
#########################################

record(longin, "$(P)Diagnostics:DesyncCount") {
    field(DESC, "FIFO desynchronizations")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),0) DIAG_DESYNC_COUNT")
    field(SCAN, "I/O Intr")
}

record(longin, "$(P)Diagnostics:ResyncCount") {
    field(DESC, "FIFO resynchronizations")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),0) DIAG_RESYNC_COUNT")
    field(SCAN, "I/O Intr")
}

record(longin, "$(P)Diagnostics:DiscardedWords") {
    field(DESC, "Total discarded FIFO words")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),0) DIAG_DISCARDED_WORDS")
    field(SCAN, "I/O Intr")
}

record(longin, "$(P)Diagnostics:BLTErrorCount") {
    field(DESC, "Failed or partial BLT reads")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),0) DIAG_BLT_ERROR_COUNT")
    field(SCAN, "I/O Intr")
}



