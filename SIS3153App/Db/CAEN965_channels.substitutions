# Substitution file for the 16 physical channels of a CAEN V965.
# P, PORT and BASE are supplied by dbLoadTemplate().  Address suffixes do not
# include 0x because the template concatenates them with BASE (e.g. 0xee00 +
# 10A0 -> 0xee0010A0).
file "../../db/CAEN965_channel.template" {
    pattern { CHAN, THRS_ADDR_HIGH, THRS_ADDR_LOW }
            { "0",  "1080",         "1082" }
            { "1",  "1084",         "1086" }
            { "2",  "1088",         "108A" }
            { "3",  "108C",         "108E" }
            { "4",  "1090",         "1092" }
            { "5",  "1094",         "1096" }
            { "6",  "1098",         "109A" }
            { "7",  "109C",         "109E" }
            { "8",  "10A0",         "10A2" }
            { "9",  "10A4",         "10A6" }
            { "10", "10A8",         "10AA" }
            { "11", "10AC",         "10AE" }
            { "12", "10B0",         "10B2" }
            { "13", "10B4",         "10B6" }
            { "14", "10B8",         "10BA" }
            { "15", "10BC",         "10BE" }
}
